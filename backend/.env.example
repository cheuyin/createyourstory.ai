# FastAPI settings
API_PREFIX=/api
DEBUG=false

# Supabase PostgreSQL connection pooler URI
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Required for story and image generation
OPENROUTER_API_KEY=your_openrouter_api_key

# Use a long, random value in your local .env and deployment environment
JWT_SECRET_KEY=replace_with_a_long_random_secret
